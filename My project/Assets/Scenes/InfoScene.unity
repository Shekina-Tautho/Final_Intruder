--- !u!114 &576830565
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 576830564}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 00d2cc8a1c6cae84dadcee14a210cfda, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  models:
  - modelObject: {fileID: 971247731}
    modelName: 'Influenza A Virus '
    levelInfo: INFLUENZA VIRUS COMPONENTS
    definitionTitle: Definition
    definitionText: 'A type of influenza virus that causes respiratory infection.
      It contains genetic material made of RNA enclosed within a protein core and
      a lipid envelope. '
    processTitle: Process Involved in the Simulation
    processText: "Stages 1\u20137: The virus is transmitted, attaches to a respiratory
      epithelial cell, enters it, replicates, and produces new virus particles. "
  - modelObject: {fileID: 415533596}
    modelName: 'Hemagglutinin  (HA / H1) '
    levelInfo: INFLUENZA VIRUS COMPONENTS
    definitionTitle: Definition
    definitionText: A surface protein that allows the influenza virus to attach to
      host cells by binding to sialic-acid-containing structures on their surface.
    processTitle: Process Involved in the Simulation
    processText: "Stage 3 \u2013 Attachment: HA binds to sialic-acid-containing structures
      on the epithelial cell, allowing the virus to attach. It also plays a role
      in membrane fusion during Stage 4."
  - modelObject: {fileID: 1129401628}
    modelName: 'Neuraminidase (NA / N1) '
    levelInfo: INFLUENZA VIRUS COMPONENTS
    definitionTitle: Definition
    definitionText: A surface protein that helps newly formed influenza viruses detach
      from the host cell by removing sialic acid from the cell surface.
    processTitle: Process Involved in the Simulation
    processText: "Stage 6 \u2013 Production and Release: NA helps newly formed virus
      particles separate from the host cell after budding."
  - modelObject: {fileID: 1739630520}
    modelName: Ribonucleoprotein (RNP / vRNP)
    levelInfo: INFLUENZA VIRUS COMPONENTS
    definitionTitle: Definition
    definitionText: A complex made of viral RNA, nucleoproteins, and viral polymerase
      proteins. It carries and helps process the virus's genetic material.
    processTitle: Process Involved in the Simulation
    processText: "Stages 4\u20136: RNPs are released during viral entry, transported
      into the nucleus, replicated and transcribed, and later transported out for
      packaging into new virus particles. "
  - modelObject: {fileID: 1195221073}
    modelName: 'Respiratory Epithelial Cell '
    levelInfo: HOST-CELL STRUCTURES AND ORGANELLES
    definitionTitle: Definition
    definitionText: A cell that lines the respiratory tract and forms a protective
      barrier against harmful particles and invading microorganisms.
    processTitle: Process Involved in the Simulation
    processText: "Stages 2\u20137: The virus encounters, attaches to, enters, and
      uses the epithelial cell to produce new virus particles. "
  - modelObject: {fileID: 1135084695}
    modelName: Sialic Acid Receptor
    levelInfo: HOST-CELL STRUCTURES AND ORGANELLES
    definitionTitle: Definition
    definitionText: A sugar-containing structure found on the surface of host cells.
      Influenza HA binds to sialic acid-containing structures to begin infection.
    processTitle: Process Involved in the Simulation
    processText: "Stage 3 \u2013 Attachment: These structures serve as binding sites
      for the viral HA protein, allowing influenza to attach to the epithelial cell."
  - modelObject: {fileID: 1076747264}
    modelName: Plasma Membrane / Cell Membrane
    levelInfo: HOST-CELL STRUCTURES AND ORGANELLES
    definitionTitle: Definition
    definitionText: The outer boundary of a cell. It controls the movement of substances
      into and out of the cell and participates in viral entry and release.
    processTitle: Process Involved in the Simulation
    processText: 'Stages 3, 4, and 6: The membrane provides the surface for viral
      attachment, folds around the virus during endocytosis, and serves as the site
      where newly assembled viruses bud and are released.'
  - modelObject: {fileID: 984095256}
    modelName: Nucleus
    levelInfo: HOST-CELL STRUCTURES AND ORGANELLES
    definitionTitle: Definition
    definitionText: The organelle that contains the host cell's genetic material.
      Influenza A also uses the nucleus to transcribe and replicate its viral RNA.
    processTitle: Process Involved in the Simulation
    processText: "Stage 5 \u2013 Viral Replication: Viral RNPs enter the nucleus,
      where viral RNA transcription and replication occur. Newly formed RNPs are
      subsequently transported out of the nucleus. "
  - modelObject: {fileID: 1425877928}
    modelName: Messenger RNA (mRNA)
    levelInfo: HOST-CELL STRUCTURES AND ORGANELLES
    definitionTitle: Definition
    definitionText: A temporary RNA copy containing instructions for making proteins.
      Influenza viral mRNA travels from the nucleus to the cytoplasm, where ribosomes
      translate it.
    processTitle: Process Involved in the Simulation
    processText: "Stage 5 \u2013 Viral Replication: Viral mRNA is produced in the
      nucleus and transported to ribosomes for protein synthesis. "
  - modelObject: {fileID: 1653411208}
    modelName: Ribosomes
    levelInfo: HOST-CELL STRUCTURES AND ORGANELLES
    definitionTitle: Definition
    definitionText: Cellular structures that read messenger RNA and use its instructions
      to produce proteins.
    processTitle: Process Involved in the Simulation
    processText: "Stage 5 \u2013 Viral Replication: Ribosomes translate viral mRNA
      to produce proteins needed for viral replication and the formation of new virus
      particles. \r\n\r\n"
  - modelObject: {fileID: 819627024}
    modelName: Proteins
    levelInfo: HOST-CELL STRUCTURES AND ORGANELLES
    definitionTitle: Definition
    definitionText: A molecule made of amino acids that performs specific functions
      in cells. Influenza uses newly produced viral proteins to help replicate its
      genetic material and build new virus particles.
    processTitle: Process Involved in the Simulation
    processText: "Stages 5\u20136: Viral proteins are produced by ribosomes. Some
      help form new RNPs, while others are transported to the cell membrane for incorporation
      into new virus particles."
  modelNameText: {fileID: 2005241214}
  levelInfoText: {fileID: 1421623203}
  definitionTitleText: {fileID: 2089213659}
  definitionText: {fileID: 324520385}
  processTitleText: {fileID: 548375181}
  processText: {fileID: 1433128051}
  thumbstickThreshold: 0.7
  thumbstickDeadZone: 0.25
